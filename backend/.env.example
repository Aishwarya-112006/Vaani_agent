# VaaniAgent backend — copy to .env and fill in real values
# cp .env.example .env

# Server
HOST=0.0.0.0
PORT=8000
# Comma-separated origins allowed by CORS (frontend dev server)
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Groq — LLM + Whisper STT
# https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here
GROQ_CHAT_MODEL=llama-3.1-8b-instant
GROQ_STT_MODEL=whisper-large-v3-turbo

# Rime — TTS (DataForge Rime Track)
# https://rime.ai/
RIME_API_KEY=your_rime_api_key_here
RIME_API_URL=https://users.rime.ai/v1/rime-tts
RIME_SPEAKER=luna
RIME_MODEL_ID=arcana
RIME_AUDIO_FORMAT=mp3
