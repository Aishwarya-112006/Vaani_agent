# Backend .env.example — copy to .env and fill in real values
# cp .env.example .env

# Server
HOST=0.0.0.0
PORT=8000
# Dev: localhost only. On Render/prod set explicit origins (never leave * in prod):
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-app.vercel.app
# D1: verify this matches the deployed frontend URL before demo.
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Groq — LLM + Whisper STT
GROQ_API_KEY=your_groq_api_key_here
# Chat model is unused by the live /message path (interrupts are rule-based in
# api/main.py). Kept for agent/pipeline.py experiments only.
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
# Fallback if STT is slow or throttled mid-demo (faster, slightly less accurate):
# GROQ_STT_MODEL=whisper-large-v3-turbo
# auto = detect Hindi/English from audio; or force: en | hi
GROQ_STT_LANGUAGE=auto

# Rime — TTS (DataForge Rime Track)
RIME_API_KEY=your_rime_api_key_here
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_SPEAKER=luna
RIME_MODEL_ID=arcana
# eng for English voices; Hindi replies auto-switch to nadi + coda
RIME_LANGUAGE=eng
RIME_AUDIO_FORMAT=mp3
RIME_SPEAKER_HI=nadi
RIME_MODEL_ID_HI=coda

# Optional — IP → city greeting on POST /session (never required for boot)
IPINFO_TOKEN=

# Optional — live hotel/restaurant search via Geoapify (OpenStreetMap)
# Free key (no card): https://myprojects.geoapify.com/
# Leave USE_LIVE_PLACES=0 for deterministic tests/eval (mock inventory).
GEOAPIFY_API_KEY=
USE_LIVE_PLACES=0
