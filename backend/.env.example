# Backend .env.example — copy to .env and fill in real values
# cp .env.example .env

# Server
HOST=0.0.0.0
PORT=8000
# If :8000 is ghost-bound on Windows, use PORT=8002 and set frontend
# VITE_API_URL=http://localhost:8002 (one BE process only).

# Dev: list every Vite origin you might hit (8080 bumps to 8081/8082 when busy).
# Prod: set explicit deployed frontend URL(s) — never leave * in prod.
# CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,https://your-app.vercel.app
CORS_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:8081,http://127.0.0.1:8081,http://localhost:8082,http://127.0.0.1:8082

# Groq — Whisper STT (mic)
GROQ_API_KEY=your_groq_api_key_here
# Chat model unused by live /message (interrupts are rule-based in api/main.py).
GROQ_LLM_MODEL=openai/gpt-oss-20b
GROQ_STT_MODEL=whisper-large-v3
# Faster STT if throttled mid-demo:
# GROQ_STT_MODEL=whisper-large-v3-turbo
# auto = detect Hindi/English from audio; or force: en | hi
GROQ_STT_LANGUAGE=auto

# Rime — TTS (DataForge Rime Track)
RIME_API_KEY=your_rime_api_key_here
RIME_ENDPOINT=https://users.rime.ai/v1/rime-tts
RIME_SPEAKER=luna
RIME_MODEL_ID=arcana
# eng for English voices; Hindi replies auto-switch to nadi + coda
RIME_LANGUAGE=eng
RIME_AUDIO_FORMAT=mp3
RIME_SPEAKER_HI=nadi
RIME_MODEL_ID_HI=coda

# Optional — IP → city greeting on POST /session (never required for boot)
IPINFO_TOKEN=

# Optional — live hotel/restaurant search via Geoapify (OpenStreetMap)
# Free key: https://myprojects.geoapify.com/
# USE_LIVE_PLACES=0 → mock inventory (~4–5s delay, good for interrupt demos + pytest)
# USE_LIVE_PLACES=1 → Geoapify only (NO mock fallback on empty/error)
# Map pins: key also geocodes mock results when live is off.
GEOAPIFY_API_KEY=
USE_LIVE_PLACES=0

# Tests lock places via VAANI_LOCK_PLACES_ENV=1 in tests/conftest.py — do not set that in .env for demos.
